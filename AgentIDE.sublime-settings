{
    // Print connection/handshake traffic to the Sublime console.
    "debug": true,

    // Start the server when Sublime starts.
    "auto_start": true,

    // Fixed port (1024-65535), or null for a random port. A fixed port
    // lets you set a machine-wide CLAUDE_CODE_SSE_PORT env var once so
    // every CLI session auto-connects. Falls back to random if busy.
    "port": null,

    // Name shown in the connecting CLI's IDE picker and the lock file.
    "ide_name": "Sublime Text",

    // Open files the CLI shows (openFile) in a right-hand side group,
    // keeping your own tabs untouched. Also used for where a diff review
    // opens. Set false to use the active group.
    "open_in_side_group": true,

    // Debounce for selection_changed notifications (milliseconds).
    "selection_debounce_ms": 200,

    // Window Layout and Split Behavior
    "layout": {
        // Restore original window layout after AgentIDE operations
        "restore_on_close": true,

        // When to restore: "always", "when_empty", "manual", "never"
        "restore_timing": "when_empty",

        // Split position: "right", "left", "bottom", "top"
        "split_position": "right",

        // Split size as percentage (0.1 to 0.9)
        "split_size": 0.45,

        // Split orientation: "vertical", "horizontal"
        "split_orientation": "vertical",

        // Create new window instead of splitting existing
        "use_new_window": false,

        // Override existing window layout if needed
        "override_existing_layout": true,

        // Save user manual layout changes made during AgentIDE session
        "preserve_manual_changes": false,

        // Layout behavior for multiple windows: "independent", "sync", "primary_only"
        "multi_window_behavior": "independent",

        // Restore layout for specific window only or all windows
        "restore_scope": "active_window",

        // Auto-collapse side group when not in use
        "auto_collapse": false,

        // Expand side group on hover when collapsed
        "expand_on_hover": false,

        // Animation duration for layout transitions (ms)
        "transition_duration": 0,

        // Focus behavior: "new_content", "keep_current", "alternate"
        "focus_behavior": "new_content",

        // Z-order behavior for AgentIDE windows
        "z_order": "normal",

        // Full screen behavior: "respect", "exit", "ignore"
        "fullscreen_behavior": "respect",

        // Minimize/maximize behavior: "respect", "restore", "ignore"
        "minimize_behavior": "respect",

        // Session persistence: "remember", "reset", "ask"
        "session_persistence": "reset",

        // Project-specific layouts: "enabled", "disabled", "fallback"
        "project_layouts": "disabled",

        // Language-specific layouts: "enabled", "disabled", "fallback"
        "language_layouts": "disabled",

        // File-type-specific layouts: "enabled", "disabled", "fallback"
        "filetype_layouts": "disabled",

        // Diff-specific layout override
        "diff_layout_override": null,

        // Preview-specific layout override
        "preview_layout_override": null,

        // Custom layout templates by name
        "layout_templates": {},

        // Default layout template to use
        "default_template": null,

        // Garbage collection for saved layouts (hours)
        "layout_gc_hours": 24,

        // Maximum number of saved layouts per window
        "max_saved_layouts": 10,

        // Layout compression/optimization
        "optimize_layouts": true,

        // Layout validation before restore
        "validate_on_restore": true,

        // Fallback layout if restore fails
        "fallback_layout": null,

        // Layout migration on version change
        "migrate_layouts": true,

        // Layout backup before modification
        "backup_layouts": true,

        // Maximum backup versions
        "max_backup_versions": 5,

        // Layout checksum validation
        "checksum_validation": false,

        // Layout encryption for sensitive projects
        "encrypt_layouts": false,

        // Layout sharing between sessions
        "share_layouts": false,

        // Layout sync across multiple monitors
        "multi_monitor_sync": false,

        // Layout adaptation for different screen sizes
        "adaptive_layouts": true,

        // Minimum window size for split
        "min_window_size": 400,

        // Maximum window size for split
        "max_window_size": null,

        // Layout constraints: "strict", "loose", "none"
        "layout_constraints": "loose",

        // Tab bar behavior in side group: "show", "hide", "auto"
        "tab_bar_behavior": "show",

        // Scroll sync between groups: "enabled", "disabled", "manual"
        "scroll_sync": "disabled",

        // Linked scrolling behavior
        "linked_scrolling": false,

        // Independent scrolling in groups
        "independent_scrolling": true,

        // Maximize content on open
        "maximize_on_open": false,

        // Minimize other content on open
        "minimize_others": false,

        // Focus retention after close
        "retain_focus": true,

        // Window stacking order
        "stacking_order": "normal",

        // Workspace association for layouts
        "workspace_association": false,

        // Layout inheritance from parent windows
        "layout_inheritance": true,

        // Layout priority conflicts: "agentide", "user", "merge"
        "layout_priority": "merge",

        // Layout transition smoothing
        "smooth_transitions": false,

        // Layout restoration delay (ms)
        "restore_delay": 0,

        // Layout validation strictness: "strict", "moderate", "lenient"
        "validation_strictness": "moderate",

        // Layout error handling: "ignore", "warn", "error", "fallback"
        "error_handling": "warn",

        // Layout performance mode: "quality", "balanced", "performance"
        "performance_mode": "balanced",

        // Layout memory management: "aggressive", "normal", "conservative"
        "memory_management": "normal",

        // Layout cleanup on exit
        "cleanup_on_exit": true,

        // Layout diagnostics: "enabled", "disabled", "on_error"
        "diagnostics": "on_error"
    }
}
